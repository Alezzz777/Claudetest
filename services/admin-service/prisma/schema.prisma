generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql"; url = env("DATABASE_URL") }

model EventStore { id String @id @default(uuid()); aggregateId String; aggregateType String; eventType String; sequence Int; payload Json; correlationId String; causationId String?; createdAt DateTime @default(now()); @@unique([aggregateId, sequence]); @@index([aggregateId]); @@map("event_store") }
model Outbox { id String @id; eventType String; aggregateType String; aggregateId String; payload Json; topic String; partitionKey String; status String @default("PENDING"); attempts Int @default(0); createdAt DateTime @default(now()); processedAt DateTime?; lastError String?; @@index([status, attempts]); @@map("outbox") }
model ProcessedEvent { eventId String @id; processedAt DateTime; @@map("processed_events") }
model UserProjection { userId String @id; email String @unique; displayName String; keycloakId String @unique; roles Json; tenantId String; isActive Boolean @default(true); createdAt DateTime @default(now()); updatedAt DateTime @updatedAt; @@map("user_projections") }
model AuditLog { id String @id; eventType String; aggregateType String; aggregateId String; correlationId String; source String; payload Json; occurredAt DateTime; @@index([aggregateId]); @@index([occurredAt]); @@map("audit_logs") }

model UserProfile { id String @id @default(uuid()); userId String @unique; email String @unique; displayName String; keycloakId String @unique; tenantId String; isActive Boolean @default(true); createdAt DateTime @default(now()); updatedAt DateTime @updatedAt; @@map("user_profiles") }

model SchemaVersion { id String @id @default(uuid()); subject String; version Int; schema Json; compatibility String; registeredAt DateTime @default(now()); registeredBy String; @@unique([subject, version]); @@map("schema_versions") }

model SagaInstance { id String @id @default(uuid()); sagaId String @unique; sagaType String; status String; context Json; steps Json; correlationId String; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt; completedAt DateTime?; @@map("saga_instances") }
