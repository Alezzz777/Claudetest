generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql"; url = env("DATABASE_URL") }
model EventStore { id String @id @default(uuid()); aggregateId String; aggregateType String; eventType String; sequence Int; payload Json; correlationId String; causationId String?; createdAt DateTime @default(now()); @@unique([aggregateId, sequence]); @@index([aggregateId]); @@map("event_store") }
model Outbox { id String @id; eventType String; aggregateType String; aggregateId String; payload Json; topic String; partitionKey String; status String @default("PENDING"); attempts Int @default(0); createdAt DateTime @default(now()); processedAt DateTime?; lastError String?; @@index([status, attempts]); @@map("outbox") }
model ProcessedEvent { eventId String @id; processedAt DateTime; @@map("processed_events") }
model DeviceProjection { deviceId String @id; status String; protocol String; unsPath String?; lastSeenAt DateTime?; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt; @@index([status]); @@map("device_projections") }
model TelemetryBuffer { id String @id @default(uuid()); deviceId String; metric String; value Float; uom String?; protocol String; timestamp DateTime; published Boolean @default(false); createdAt DateTime @default(now()); @@index([deviceId, timestamp]); @@index([published]); @@map("telemetry_buffer") }
