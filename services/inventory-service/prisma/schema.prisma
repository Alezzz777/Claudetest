generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql"; url = env("DATABASE_URL") }

model EventStore {
  id String @id @default(uuid()); aggregateId String; aggregateType String; eventType String
  sequence Int; payload Json; correlationId String; causationId String?; createdAt DateTime @default(now())
  @@unique([aggregateId, sequence]); @@index([aggregateId]); @@map("event_store")
}
model Outbox {
  id String @id; eventType String; aggregateType String; aggregateId String; payload Json
  topic String; partitionKey String; status String @default("PENDING"); attempts Int @default(0)
  createdAt DateTime @default(now()); processedAt DateTime?; lastError String?
  @@index([status, attempts]); @@map("outbox")
}
model ProcessedEvent { eventId String @id; processedAt DateTime; @@map("processed_events") }

model LotProjection {
  lotId String @id; lotNumber String @unique; materialId String; materialCode String
  quantity Float; uom String; locationId String; orderId String?; status String @default("AVAILABLE")
  tenantId String; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt
  @@index([locationId]); @@index([materialId]); @@index([status]); @@map("lot_projections")
}

model ReservationProjection {
  reservationId String @id; lotId String; orderId String; quantity Float
  status String @default("ACTIVE"); createdAt DateTime @default(now()); fulfilledAt DateTime?
  @@index([orderId]); @@map("reservation_projections")
}
